@page "/event-list"
@using EventEase.Services
@inject EventService EventService

<h1>Events</h1>
<table>
    <thead>
        <th>Name</th>
        <th>Date</th>
        <th>Location</th>
        <th>Description</th>
        <th>Registered Users</th>
    </thead>
    <tbody>
        @foreach (var anEvent in EventService.GetEventsList()) 
        {
            <tr>
                <td>@anEvent.Name</td>
                <td>@anEvent.Date</td>
                <td>@anEvent.Location</td>
                <td>@anEvent.Description</td>
                <td>@anEvent.GetRegisteredString()</td>
            </tr>
        }
    </tbody>
</table>
